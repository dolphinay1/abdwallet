# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is gitignored for a reason.

NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_DOMAIN=""

# RPC endpoints (NEXT_PUBLIC_ prefix = accessible client-side)
NEXT_PUBLIC_RPC_ETHEREUM="https://eth.llamarpc.com"
NEXT_PUBLIC_RPC_BNB="https://bsc-dataseed.binance.org/"
NEXT_PUBLIC_RPC_POLYGON="https://polygon-rpc.com"
NEXT_PUBLIC_RPC_ARBITRUM="https://arb1.arbitrum.io/rpc"
NEXT_PUBLIC_RPC_OPTIMISM="https://mainnet.optimism.io"
NEXT_PUBLIC_RPC_BASE="https://mainnet.base.org"
NEXT_PUBLIC_RPC_AVALANCHE="https://avalanche.public-rpc.com"
NEXT_PUBLIC_RPC_FANTOM="https://rpc.ftm.tools"

# Server-side RPC (private API key, never exposed to the client)
RPC_ETHEREUM=""
RPC_BNB=""
RPC_POLYGON=""
RPC_ARBITRUM=""
RPC_OPTIMISM=""
RPC_BASE=""
RPC_AVALANCHE=""
RPC_FANTOM=""

# Alchemy API (for NFT fetching)
ALCHEMY_API_KEY=""

# Etherscan-family explorer API (tx history — one key works for etherscan/basescan/bscscan/arbiscan etc.)
ETHERSCAN_API_KEY=""

# LiFi API (optional — works without a key; key provides higher rate limits)
# https://li.fi/plans — never sent to the client (server-side proxy)
LIFI_API_KEY=""

# WalletConnect v2 — get a free project ID from https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=""
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Panic redirect URL
NEXT_PUBLIC_EXTERNAL_LINK=""

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Fee Percentages (optional)
NEXT_PUBLIC_FEE_MAJORITY_PERCENT="0.7"
NEXT_PUBLIC_FEE_MINOR_PERCENT="0.5"

# Upstash Redis Distributed Rate Limiting (optional — falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

