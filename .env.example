# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is gitignored for a reason.

NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_DOMAIN=""

# RPC Uç Noktaları (NEXT_PUBLIC_ prefix = client-side erişilebilir)
NEXT_PUBLIC_RPC_ETHEREUM="https://eth.llamarpc.com"
NEXT_PUBLIC_RPC_BNB="https://bsc-dataseed.binance.org/"
NEXT_PUBLIC_RPC_POLYGON="https://polygon-rpc.com"
NEXT_PUBLIC_RPC_ARBITRUM="https://arb1.arbitrum.io/rpc"
NEXT_PUBLIC_RPC_OPTIMISM="https://mainnet.optimism.io"
NEXT_PUBLIC_RPC_BASE="https://mainnet.base.org"
NEXT_PUBLIC_RPC_AVALANCHE="https://avalanche.public-rpc.com"
NEXT_PUBLIC_RPC_FANTOM="https://rpc.ftm.tools"

# Sunucu-taraflı RPC (özel API key'li, client'a gönderilmez)
RPC_ETHEREUM=""
RPC_BNB=""
RPC_POLYGON=""
RPC_ARBITRUM=""
RPC_OPTIMISM=""
RPC_BASE=""
RPC_AVALANCHE=""
RPC_FANTOM=""

# Alchemy API (NFT fetching için)
ALCHEMY_API_KEY=""

# Etherscan-ailesi explorer API (tx history — tek anahtar etherscan/basescan/bscscan/arbiscan vb. tümünde geçerli)
ETHERSCAN_API_KEY=""

# LiFi API (opsiyonel — anahtarsız da çalışır; anahtar daha yüksek rate limit sağlar)
# https://li.fi/plans — asla client'a gönderilmez (server-side proxy kullanır)
LIFI_API_KEY=""

# WalletConnect v2 — https://cloud.reown.com adresinden ücretsiz proje ID alın
NEXT_PUBLIC_WC_PROJECT_ID=""
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Panic redirect URL
NEXT_PUBLIC_EXTERNAL_LINK=""

# Supabase (opsiyonel)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Fee Percentages (opsiyonel)
NEXT_PUBLIC_FEE_MAJORITY_PERCENT="0.7"
NEXT_PUBLIC_FEE_MINOR_PERCENT="0.5"

